---
import '@fontsource/permanent-marker/latin-400.css';
import '@fontsource/caveat/latin-700.css';
import '@fontsource/courier-prime/latin-400.css';
import '@fontsource/courier-prime/latin-700.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/vt323/latin-400.css';
import marcaWoff from '@fontsource/permanent-marker/files/permanent-marker-latin-400-normal.woff2?url';
import textoWoff from '@fontsource/courier-prime/files/courier-prime-latin-400-normal.woff2?url';
import '../styles/sitio.css';
import { relato, ui, type Idioma } from '../data/relato.ts';
import { paradas, subPos } from '../lib/logica.ts';

interface Props {
  idioma: Idioma;
}
const { idioma: L } = Astro.props;
const otro: Idioma = L === 'es' ? 'en' : 'es';
const url = (l: Idioma) => new URL(`/${l}/`, Astro.site).href;
const ps = paradas(relato.capitulos);
const i = (id: string) => ps.findIndex((p) => p.id === id);
const caps = relato.capitulos;
const ultimo = caps.length - 1;

// Fondo de estrellas, con semilla fija para que el build sea reproducible.
let semilla = 7;
const azar = () => (semilla = (semilla * 9301 + 49297) % 233280) / 233280;
const fondo = Array.from({ length: 90 }, () => ({ x: azar() * 100, y: azar() * 100, z: 1 + azar() * 1.6 }));
const subs = caps.map((c) =>
  c.pasos.map((_, k) => ({
    d: subPos(c.pos.escritorio, k, c.pasos.length, false),
    m: subPos(c.pos.movil, k, c.pasos.length, true),
  })),
);
const pos = (d: { x: number; y: number }, m: { x: number; y: number }) =>
  `--x:${d.x}%;--y:${d.y}%;--xm:${m.x}%;--ym:${m.y}%`;
const futuras = [
  { d: { x: 92, y: 14 }, m: { x: 84, y: 12 } },
  { d: { x: 96, y: 24 }, m: { x: 92, y: 18 } },
  { d: { x: 89, y: 8 }, m: { x: 76, y: 8 } },
];
const corto = (c: (typeof caps)[number], k: number) => (k === ultimo ? ui.hoy[L] : c.fecha[L].match(/\d{4}/)?.[0]);

// Constelación del cierre: 4 puntos por grupo alrededor de su centro (% de la caja).
const centros = [
  { x: 24, y: 18 },
  { x: 74, y: 30 },
  { x: 28, y: 62 },
  { x: 76, y: 74 },
];
const offs = [
  [-7, -6],
  [6, -9],
  [9, 4],
  [-4, 8],
];
const puntos = centros.map((c) => offs.map(([dx, dy]) => ({ x: c.x + dx, y: c.y + dy, dx: Math.round((azar() - 0.5) * 400), dy: Math.round((azar() - 0.5) * 300) })));
const linea = (a: { x: number; y: number }, b: { x: number; y: number }) => ({ x1: a.x, y1: a.y, x2: b.x, y2: b.y });
---

<!doctype html>
<html lang={ui.lang[L]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{ui.titulo[L]}</title>
    <meta name="description" content={ui.descripcion[L]} />
    <meta name="theme-color" content="#0F0E1A" />
    <link rel="canonical" href={url(L)} />
    <link rel="alternate" hreflang="es" href={url('es')} />
    <link rel="alternate" hreflang="en" href={url('en')} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site).href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ui.titulo[L]} />
    <meta property="og:description" content={ui.descripcion[L]} />
    <meta property="og:url" content={url(L)} />
    <meta property="og:locale" content={L === 'es' ? 'es_AR' : 'en_US'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="font" type="font/woff2" href={marcaWoff} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={textoWoff} crossorigin />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {
      relato.goatcounter && (
        <script is:inline async data-goatcounter={`https://${relato.goatcounter}.goatcounter.com/count`} src="//gc.zgo.at/count.js" />
      )
    }
  </head>
  <body>
    <a class="saltar" href="#hoy">{ui.saltar[L]}</a>

    <header class="barra">
      <a class="marca" href="#hoy">{relato.nombre}</a>
      <span class="sep"></span>
      <a class="btn" id="idioma" href={`/${otro}/`} hreflang={otro} lang={otro} aria-label={ui.otroIdiomaNombre[L]}>{ui.otroIdioma[L]}</a>
      <button class="btn" id="sonido" type="button" hidden aria-label={ui.sonido[L]} data-off={ui.sonidoEstado.off[L]} data-sistema={ui.sonidoEstado.sistema[L]} data-ambiente={ui.sonidoEstado.ambiente[L]}>
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2 6h3l4-3v10L5 10H2z" fill="currentColor" /><path d="M11 5.5a3.5 3.5 0 0 1 0 5" stroke="currentColor" fill="none" stroke-width="1.4" /></svg>
        <span>{ui.sonidoEstado.off[L]}</span>
      </button>
      <a class="btn contacto" href="#contacto">{ui.contacto[L]}</a>
    </header>

    <nav class="cinta" aria-label={ui.cinta[L]}>
      <ol>
        {
          caps.map((c, k) => (
            <li>
              <a href={`#${c.id}`} data-cap={k} aria-label={`${c.fecha[L]} · ${c.nombre[L]}`}>
                <span class="largo">{c.fecha[L]}</span>
                <span class="corto">{corto(c, k)}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="osd" aria-hidden="true" data-g="rec">
      <svg class="glifo" viewBox="0 0 16 16" width="16" height="16"><circle cx="8" cy="8" r="5" /></svg>
      <span class="osd-lab">REC</span>
      <span class="osd-fecha"></span>
    </div>
    <p class="sr-only" id="anuncio" aria-live="polite"></p>

    <div class="cielo" aria-hidden="true">
      <div class="mundo">
        <div class="fondo">{fondo.map((s) => <i style={`left:${s.x.toFixed(1)}%;top:${s.y.toFixed(1)}%;width:${s.z.toFixed(1)}px;height:${s.z.toFixed(1)}px`} />)}</div>
        <svg class="trazos" viewBox="0 0 100 100" preserveAspectRatio="none">
          {
            (['escritorio', 'movil'] as const).map((v) => (
              <g class={v === 'escritorio' ? 'v-d' : 'v-m'}>
                {caps.slice(1).map((c, j) => (
                  <line class="linea" data-linea={j} {...linea(caps[j].pos[v], c.pos[v])} />
                ))}
                {caps.map((c, k) =>
                  subs[k].map((s, n) => <line class="subl" data-subl={`${k}-${n}`} {...linea(c.pos[v], v === 'escritorio' ? s.d : s.m)} />),
                )}
              </g>
            ))
          }
        </svg>
        {
          caps.map((c, k) => (
            <>
              <span class="est cap" data-cap={k} style={pos(c.pos.escritorio, c.pos.movil)}>
                <span class="p" />
              </span>
              <span class="lbl cap" data-cap={k} style={pos(c.pos.escritorio, c.pos.movil)}>
                <b>{c.fecha[L]}</b>
                {c.nombre[L]}
              </span>
              {c.pasos.map((p, n) => (
                <>
                  <span class="est sub" data-c={k} data-k={n} style={pos(subs[k][n].d, subs[k][n].m)}>
                    <span class="p" />
                  </span>
                  <span class="lbl sub" data-c={k} data-k={n} style={pos(subs[k][n].d, subs[k][n].m)}>
                    {p.rotulo[L]}
                  </span>
                </>
              ))}
            </>
          ))
        }
        {
          futuras.map((f) => (
            <span class="est fut" style={pos(f.d, f.m)}>
              <span class="p" />
            </span>
          ))
        }
      </div>
      <div class="scan"></div>
    </div>

    <main id="relato">
      <section id="hoy" class="parada hoy" data-i="0" aria-labelledby="t-hoy">
        <div class="hoy-caja">
          <p class="hoy-fecha t1">{relato.hoy.fecha[L]}</p>
          <h1 id="t-hoy" class="t1">{relato.nombre}</h1>
          <p class="titular t1">{relato.titular[L]}</p>
          <p class="hoy-frase t2">{relato.hoy.frase[L]}</p>
          <ul class="cifras t3">
            {
              relato.hoy.cifras.map((c) => (
                <li>
                  <b>{c.valor[L]}</b>
                  <span>{c.rotulo[L]}</span>
                </li>
              ))
            }
          </ul>
          <p class="t3"><a class="btn cta" href={`#${caps[0].id}`}>{ui.comoLlegue[L]} <span aria-hidden="true">▶</span></a></p>
          <p class="ayuda t3">{ui.ayudaAvance[L]}</p>
        </div>
      </section>

      {
        caps.map((c) => (
          <section class="capitulo" id={c.id} aria-labelledby={`t-${c.id}`}>
            <div class="parada titulo" data-i={i(c.id)}>
              <h2 id={`t-${c.id}`} class="subt">
                <span class="fecha">
                  {c.fecha[L]}
                  {c.lugar && ` · ${c.lugar}`}
                </span>
                <span class="nombre">{c.nombre[L]}</span>
              </h2>
            </div>
            <ol class="pasos">
              {c.pasos.map((p, n) => (
                <li class="parada paso" id={p.id} data-i={i(p.id)}>
                  <p class="subt">
                    <span class="fecha">
                      {c.fecha[L]} · {p.rotulo[L]}
                    </span>
                    <span class="frase">{p.frase[L]}</span>
                  </p>
                  {n === c.pasos.length - 1 && (c.mas.length > 0 || c.repos.length > 0) && (
                    <details class="mas">
                      <summary class="btn">
                        {ui.mas[L]} <span aria-hidden="true">▾</span>
                      </summary>
                      <div class="nota">
                        <ul>
                          {c.mas.map((m) => (
                            <li>{m[L]}</li>
                          ))}
                        </ul>
                        {c.stack.length > 0 && (
                          <p>
                            <b>{ui.stack[L]}:</b> {c.stack.join(', ')}.
                          </p>
                        )}
                        {c.repos.length > 0 && (
                          <p>
                            <b>{ui.repos[L]}:</b>{' '}
                            {c.repos.map((r, k) => (
                              <>
                                {k > 0 && ' · '}
                                <a href={r.url}>{r.nombre}</a>
                              </>
                            ))}
                          </p>
                        )}
                      </div>
                    </details>
                  )}
                </li>
              ))}
            </ol>
          </section>
        ))
      }

      <section id="cielo" class="parada cielo-parada" data-i={i('cielo')} aria-labelledby="t-cielo">
        <div class="subt">
          <h2 id="t-cielo" class="fecha">{ui.cielo[L]}</h2>
          <p class="frase">{ui.cieloAyuda[L]}</p>
          <ul class="destinos">
            {
              caps.map((c) => (
                <li>
                  <a class="btn" href={`#${c.id}`}>
                    {c.fecha[L]} · {c.nombre[L]}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section id="cierre" class="parada cierre" data-i={i('cierre')} aria-labelledby="t-cierre">
        <div class="cierre-txt">
          <h2 id="t-cierre" style="--d:0">{relato.cierre.titulo[L]}</h2>
          {relato.cierre.lineas.map((l, k) => <p style={`--d:${k + 1}`}>{l[L]}</p>)}
          <p class="meta" style="--d:4">{relato.cierre.meta[L]}</p>
          <p id="contacto" class="contacto-links" style="--d:5">
            <a class="btn cta" href={`mailto:${relato.contacto.email}`}>{ui.meEscribis[L]} <span aria-hidden="true">→</span></a>
            <a class="btn" href={relato.contacto.github}>GitHub</a>
            <a class="btn" href={relato.contacto.linkedin}>LinkedIn</a>
          </p>
        </div>
        <div class="aporte">
          <svg class="aporte-trazos" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {puntos.map((g) => g.slice(1).map((p, k) => <line {...linea(g[k], p)} />))}
          </svg>
          {
            puntos.flat().map((p, k) => (
              <span class="pt" aria-hidden="true" style={`left:${p.x}%;top:${p.y}%;--dx:${p.dx}px;--dy:${p.dy}px;--n:${k}`} />
            ))
          }
          <ul class="grupos">
            {
              relato.aporte.map((g, k) => (
                <li class="grupo" style={`--gx:${centros[k].x}%;--gy:${centros[k].y + 12}%`}>
                  <b>{g.nombre[L]}</b>
                  <span>{g.items.join(' · ')}</span>
                </li>
              ))
            }
          </ul>
          <div class="orbita" aria-hidden="true"><span class="giro"><span class="sat"></span></span></div>
          <span class="fut-cierre" aria-hidden="true"><i></i><i></i><i></i></span>
        </div>
      </section>
    </main>

    <footer class="ficha">
      <h2>{ui.ficha[L]}</h2>
      <ul>
        {
          relato.ficha.map((f) => (
            <li>
              {f.url ? <a href={f.url}>{f.texto[L]}</a> : f.texto[L]}
            </li>
          ))
        }
      </ul>
    </footer>

    <script>
      import '../scripts/experiencia.ts';
    </script>
  </body>
</html>
